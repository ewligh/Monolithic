
@{
    ViewData["Title"] = "صفحه اصلی";
}

<div class="container py-5">

    <section class="home-hero text-center rounded-4 p-4 p-md-5">

        <span class="welcome-badge">
            به فروشگاه ما خوش اومدی!
        </span>

        <h1 class="hero-title mt-4">
            خریدی آسون و لذت‌بخش
        </h1>

        <p class="hero-description mt-3">
            محصولات مورد نیازت رو راحت پیدا کن و از خریدت لذت ببر.
        </p>

        <a href="#features" class="btn btn-primary btn-lg mt-3 px-4">
            شروع کن
        </a>

    </section>

    <section id="features" class="mt-5">

        <div class="text-center mb-4">
            <h2 class="section-title">چرا فروشگاه ما؟</h2>
            <p class="text-secondary">
                یه تجربه خرید راحت و متفاوت
            </p>
        </div>

        <div class="row g-4">

            <div class="col-12 col-md-4">
                <div class="feature-card h-100">
                    <div class="feature-icon">🛍️</div>
                    <h5>محصولات متنوع</h5>
                    <p>محصولات مختلف رو بررسی و انتخاب کن.</p>
                </div>
            </div>

            <div class="col-12 col-md-4">
                <div class="feature-card h-100">
                    <div class="feature-icon">⚡</div>
                    <h5>خرید آسون</h5>
                    <p>محصول مورد نظرت رو راحت پیدا کن.</p>
                </div>
            </div>

            <div class="col-12 col-md-4">
                <div class="feature-card h-100">
                    <div class="feature-icon">💎</div>
                    <h5>تجربه بهتر</h5>
                    <p>از یه محیط ساده و کاربرپسند لذت ببر.</p>
                </div>
            </div>

        </div>

    </section>

</div>
